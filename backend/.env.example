# ==============================================================================
# Backend Environment Configuration (.env)
# ==============================================================================
# 1. Copy this file to .env:  copy .env.example .env   (Windows)  |  cp .env.example .env
# 2. Replace every PLACEHOLDER below. Leaving an integration blank is fine: that feature then runs in a
#    clearly labelled SANDBOX (nothing is sent to anyone) and the app tells users so.
# 3. NEVER commit .env.
# ==============================================================================

# ---- Server -------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ---- Database (MongoDB) -------------------------------------------------------
# Local:  mongodb://localhost:27017/aai_dbitic
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aai_dbitic?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/aai_dbitic

# ---- Authentication -----------------------------------------------------------
# MUST MATCH JWT_SECRET in frontend/.env.local.
JWT_SECRET=PLACEHOLDER_long_random_string
JWT_EXPIRES_IN=7d
# Shared with the Python agent service and the frontend (INTERNAL_JWT_SECRET). Generate: openssl rand -hex 32
INTERNAL_JWT_SECRET=PLACEHOLDER_generate_with_openssl_rand_hex_32
AGENT_SERVICE_URL=http://127.0.0.1:8000

# Local-development ONLY: act as this existing account when a request carries no token. Off by default and
# ignored unless NODE_ENV=development. Never enable in a shared or production environment.
DEV_AUTH_FALLBACK=false
DEV_AUTH_FALLBACK_EMAIL=

# ---- Seed accounts (npm run seed:superadmin / seed:admin / seed:demo) ---------
SUPER_ADMIN_NAME="System Owner (Super Admin)"
SUPER_ADMIN_EMAIL=superadmin@aai-dbitic.edu
SUPER_ADMIN_PASSWORD=PLACEHOLDER_choose_a_strong_password
ADMIN_NAME="Operations Manager (Admin)"
ADMIN_EMAIL=admin@aai-dbitic.edu
ADMIN_PASSWORD=PLACEHOLDER_choose_a_strong_password
# Password for the demo founders, mentors and investors created by `npm run seed:demo` (min 10 characters).
DEMO_USER_PASSWORD=PLACEHOLDER_choose_a_demo_password

# Optional overrides for `npm run seed:all` (it has built-in defaults for local use; set these for any shared setup)
# STUDENT_EMAIL= / STUDENT_PASSWORD=
# FACULTY_PASSWORD= / COORDINATOR_PASSWORD= / VOLUNTEER_PASSWORD=
# MENTOR_PASSWORD=
# INVESTOR_EMAIL= / INVESTOR_PASSWORD=

# ==============================================================================
# AGENTS
# ==============================================================================
# The agents run in the background whenever the backend runs. Set to false to pause them.
EVENT_ORCHESTRATOR_ENABLED=true
EVENT_ORCHESTRATOR_POLL_MS=5000
AGENT_SWEEP_MS=900000
AGENT_TIMEZONE=Asia/Kolkata

# true  = never send anything externally, even if keys are present: everything is recorded in the outbox
#         as "simulated" (good for demos). false = use live integrations for whatever is configured.
AGENT_DEMO_MODE=false

# Deadlines (milliseconds) - all optional, defaults shown.
# APPLICATION_REMINDER_AFTER_MS=259200000      3 days  -> reminder to the student
# APPLICATION_ESCALATE_AFTER_MS=604800000      7 days  -> escalate to Admin
# APPLICATION_MIN_TEAM_SIZE=2
# MENTOR_RESPONSE_WINDOW_MS=259200000          3 days  -> mentor request times out
# MONITORING_CHECKIN_WAIT_MS=172800000         48 h    -> then the mentor is told
# MONITORING_MENTOR_WAIT_MS=172800000          48 h    -> then the coordinator is told
# MONITORING_INACTIVITY_DAYS=14
# INVESTOR_MIN_PROGRESS=60

# ---- Email (SMTP) - used for notices, reminders and .ics meeting invitations ---
# OPTIONAL. Leave these EMPTY to run email in the sandbox (nothing is sent). Fill ALL of host, user, password to go live.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_FROM_NAME=DBIT Incubation Centre
# Student task/meeting reminders also need this to be true (and SMTP above).
REMINDERS_ENABLED=false
REMINDER_SWEEP_MINUTES=15
DEFAULT_MEETING_LOCATION=DBIT Incubation Centre

# ---- Google Calendar - each person connects THEIR OWN Google account ----------
# OPTIONAL. Leave EMPTY to stay in the sandbox; fill all four to go live.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials (type: Web application),
# enable the "Google Calendar API", and add GOOGLE_REDIRECT_URI as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback
# Encrypts the stored Google tokens. Any long random string; changing it disconnects everyone. openssl rand -hex 32
INTEGRATIONS_ENCRYPTION_KEY=
# Public HTTPS backend origin for Google Calendar push notifications. Leave blank for local sandbox mode.
PUBLIC_API_URL=
# live registers Google watch channels; sandbox skips external webhook registration.
CALENDAR_SYNC_MODE=sandbox

# ---- AI model (shown in the status panel; the model itself runs in the Python agent service) ----
# Informational only for the status panel. Set the real key in agent-service/.env.
LLM_API_KEY=
