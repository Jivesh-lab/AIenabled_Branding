# ==============================================================================
# Backend Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env (or copy .env.example .env on Windows)
# 2. Fill in your actual secrets and connection URIs below.
# 3. DO NOT commit the .env file to version control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (MongoDB)
# Local instance: mongodb://localhost:27017/aai_dbitic
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aai_dbitic?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/aai_dbitic

# JWT Authentication
# IMPORTANT: This secret MUST MATCH the JWT_SECRET in frontend/.env.local so that
# token signatures can be mutually verified between backend and frontend.
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Super Admin Provisioning (Used by CLI seed script: npm run seed:superadmin)
SUPER_ADMIN_NAME="System Owner (Super Admin)"
SUPER_ADMIN_EMAIL=superadmin@aai-dbitic.edu
SUPER_ADMIN_PASSWORD=SuperAdmin#2026!Secure

# Admin Provisioning (Used by CLI seed script: npm run seed:admin)
ADMIN_NAME="Operations Manager (Admin)"
ADMIN_EMAIL=admin@aai-dbitic.edu
ADMIN_PASSWORD=Admin#2026!Ops
