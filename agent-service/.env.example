# ── Agent Service ─────────────────────────────────────────────────────────────
# FastAPI + LangGraph Agentic Engine
# Runs on port 8000 (alongside Express :5000 and Next.js :3000)
# ──────────────────────────────────────────────────────────────────────────────

# Server
AGENT_SERVICE_PORT=8000
AGENT_SERVICE_HOST=0.0.0.0
ENVIRONMENT=development          # development | production
LOG_LEVEL=info

# ── LLM (OpenRouter — OpenAI-compatible endpoint) ─────────────────────────────
# OPTIONAL. Without a key the service still starts: rule-based checks run, and AI-written assessments and
# answers say plainly that the model is not configured. Add the key to switch them on.
LLM_API_KEY=
# OPENROUTER_API_KEY=PLACEHOLDER_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Choose any model from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini   # ultra-fast 1s response; or meta-llama/llama-3.2-3b-instruct
OPENROUTER_EMBED_MODEL=openai/text-embedding-ada-002       # embeddings via OpenRouter

# Student assistant: set false to turn off the AI-written suggestion (verified records still show).
ASSISTANT_GUIDANCE_ENABLED=true
ASSISTANT_GUIDANCE_TIMEOUT_SECONDS=20

# Demo-only features (the built-in sample mentor directory). Keep false outside demos.
AGENT_DEMO_MODE=false

# ── PostgreSQL + pgvector ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aai_incubation
POSTGRES_USER=aai_user
POSTGRES_PASSWORD=PLACEHOLDER_database_password
DATABASE_URL=postgresql://aai_user:PLACEHOLDER_database_password@localhost:5432/aai_incubation

# ── Redis (job queue + session cache) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth (share JWT secret with Express backend) ──────────────────────────────
# Same value as JWT_SECRET in backend/.env and frontend/.env.local
JWT_SECRET=PLACEHOLDER_same_as_backend_JWT_SECRET
# Same value as backend/.env and frontend/.env.local INTERNAL_JWT_SECRET
INTERNAL_JWT_SECRET=PLACEHOLDER_generate_with_openssl_rand_hex_32

# ── SMTP Email - OPTIONAL and currently unused ────────────────────────────────
# Real email is sent by the Node backend (set SMTP_* in backend/.env). Nothing in this service calls
# its email tool, so these can stay empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=AAI Incubation Centre
SMTP_FROM_EMAIL=

# ── Web Search (Tavily) ───────────────────────────────────────────────────────
# Optional web search key; blank disables it
TAVILY_API_KEY=

# ── RAG ───────────────────────────────────────────────────────────────────────
EMBEDDING_DIM=1536              # text-embedding-ada-002 dimension
RAG_CHUNK_SIZE=512              # tokens per chunk
RAG_CHUNK_OVERLAP=50            # overlap tokens

# ── Rate Limiting ─────────────────────────────────────────────────────────────
MAX_AGENT_RUNS_PER_USER_PER_HOUR=20
MAX_TOKENS_PER_RUN=1024

# ── Frontend URL (CORS) ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
EXPRESS_API_URL=http://localhost:5000

# ── Workflow state file (optional; default is agent-service/workflow_state.sqlite) ───────────────────
# WORKFLOW_STATE_DB=
