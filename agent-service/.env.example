# ── Agent Service ─────────────────────────────────────────────────────────────
# FastAPI + LangGraph Agentic Engine
# Runs on port 8000 (alongside Express :5000 and Next.js :3000)
# ──────────────────────────────────────────────────────────────────────────────

# Server
AGENT_SERVICE_PORT=8000
AGENT_SERVICE_HOST=0.0.0.0
ENVIRONMENT=development          # development | production
LOG_LEVEL=info

# ── LLM (OpenRouter — OpenAI-compatible endpoint) ─────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Choose any model from https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free   # free tier for dev
OPENROUTER_EMBED_MODEL=openai/text-embedding-ada-002       # embeddings via OpenRouter

# ── PostgreSQL + pgvector ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aai_incubation
POSTGRES_USER=aai_user
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql://aai_user:change_this_password@localhost:5432/aai_incubation

# ── Redis (job queue + session cache) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth (share JWT secret with Express backend) ──────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ── SMTP Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=AAI Incubation Centre
SMTP_FROM_EMAIL=noreply@aai-incubation.in

# ── Web Search (Tavily) ───────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-YOUR_KEY_HERE

# ── RAG ───────────────────────────────────────────────────────────────────────
EMBEDDING_DIM=1536              # text-embedding-ada-002 dimension
RAG_CHUNK_SIZE=512              # tokens per chunk
RAG_CHUNK_OVERLAP=50            # overlap tokens

# ── Rate Limiting ─────────────────────────────────────────────────────────────
MAX_AGENT_RUNS_PER_USER_PER_HOUR=20
MAX_TOKENS_PER_RUN=4096

# ── Frontend URL (CORS) ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
EXPRESS_API_URL=http://localhost:5000
