# ==============================================================================
# Frontend Environment Configuration (.env.local)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local:  cp .env.example .env.local (or copy .env.example .env.local on Windows)
# 2. Fill in your actual secrets and service URLs below.
# 3. DO NOT commit .env.local to version control.
# ==============================================================================

# Application & API URLs
# NEXTAUTH_URL: Base URL where this Next.js app is hosted
NEXTAUTH_URL=http://localhost:3000

# NEXT_PUBLIC_API_URL: Express Backend URL accessible by the browser (client-side)
NEXT_PUBLIC_API_URL=http://localhost:5000

# BACKEND_URL: Express Backend URL accessible by Next.js server route handlers (server-side)
BACKEND_URL=http://localhost:5000

# Authentication & JWT Secrets
# NEXTAUTH_SECRET: Secret used by NextAuth to sign session cookies (generate via: openssl rand -base64 32)
# Leave empty ONLY for local development (a known dev value is used). Required in production.
NEXTAUTH_SECRET=PLACEHOLDER_openssl_rand_base64_32

# JWT_SECRET: MUST MATCH backend/.env JWT_SECRET for shared session verification
JWT_SECRET=PLACEHOLDER_same_as_backend_JWT_SECRET

# INTERNAL_JWT_SECRET: Shared secret for internal communication between frontend and agent-service
# MUST be identical in backend/.env and agent-service/.env, or calls between services fail with 401.
INTERNAL_JWT_SECRET=PLACEHOLDER_generate_with_openssl_rand_hex_32

# Agent Service (FastAPI / Python) - Optional
# NEXT_PUBLIC_AGENT_API_URL: Agent service accessible by the client browser
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000

# AGENT_SERVICE_URL: Agent service accessible by Next.js server route handlers
AGENT_SERVICE_URL=http://127.0.0.1:8000

# Google sign-in and Google Calendar are handled by the backend (see backend/.env.example); no Google keys belong here.
# GitHub / Facebook below are not wired to the application's accounts yet.
GITHUB_ID=dummy_github_id
GITHUB_SECRET=dummy_github_secret

FACEBOOK_ID=dummy_facebook_id
FACEBOOK_SECRET=dummy_facebook_secret
