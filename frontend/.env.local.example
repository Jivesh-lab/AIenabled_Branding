# NextAuth Configuration
# Replace these values with your actual OAuth credentials from each provider's developer console.

NEXTAUTH_SECRET="your-super-secret-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_ID="your_google_client_id"
GOOGLE_SECRET="your_google_client_secret"

# GitHub OAuth
GITHUB_ID="your_github_client_id"
GITHUB_SECRET="your_github_client_secret"

# Facebook OAuth
FACEBOOK_ID="your_facebook_client_id"
FACEBOOK_SECRET="your_facebook_client_secret"
