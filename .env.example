# =============================================================================
# AAI Incubation Centre — Docker Compose Environment Variables
# =============================================================================

# AI Engine (OpenRouter API Key)

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Security Secrets (Shared between services)
JWT_SECRET=change_this_to_a_long_random_secret_in_production
NEXTAUTH_SECRET=aai_dbitic_dev_secret_change_in_production
INTERNAL_JWT_SECRET=test_internal_secret_key_123

# Database Passwords
POSTGRES_PASSWORD=aai_password_123

# SMTP Notification Credentials (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dummy_sender@gmail.com
SMTP_PASSWORD=dummy_password
SMTP_FROM_EMAIL=noreply@aai-incubation.in

# Web Search Tool (Optional)
TAVILY_API_KEY=
